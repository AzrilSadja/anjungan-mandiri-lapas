# =====================================================
# App
# Laravel APP_URL -> NEXT_PUBLIC_APP_URL
# =====================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NODE_ENV="development"

# =====================================================
# Database
# Laravel DB_* -> DATABASE_URL (Prisma)
# Gunakan Vercel Postgres / Postgres kompatibel
# =====================================================
DATABASE_URL="postgresql://user:password@localhost:5432/anjungan_mandiri?schema=public"

# =====================================================
# Auth (NextAuth)
# =====================================================
AUTH_SECRET="replace-with-strong-random-secret"

# =====================================================
# Storage
# Laravel FILESYSTEM_DISK / AWS_* mapping
# =====================================================
FILESYSTEM_DISK="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
AWS_BUCKET=""
AWS_ENDPOINT=""
AWS_URL=""
AWS_USE_PATH_STYLE_ENDPOINT="false"

# =====================================================
# Mail (future migration)
# Laravel MAIL_* mapping placeholder
# =====================================================
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Anjungan Mandiri"
SMTP_HOST="127.0.0.1"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
